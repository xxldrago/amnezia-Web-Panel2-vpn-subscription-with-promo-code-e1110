# ===== Меню подготовки к деплою store-системы =====

# Общий секрет для сессии панели и store (обязательно совпадает с SECRET_KEY панели!)
SECRET_KEY=change_me_shared_secret

# Пароль PostgreSQL для store
STORE_DB_PASSWORD=change_me_db_pass

# Bearer-токен панели для авто-выдачи (awp_...) — роль admin/support
PANEL_API_TOKEN=awp_change_me

# Платёжная система Platega.io
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET_KEY=

# Telegram-бот store
TELEGRAM_BOT_TOKEN=

# === (раскомментировать при настройке SMTP-уведомлений) ===
# SMTP_SERVER=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Базовый URL магазина (совпадает с доменом)
SITE_URL=https://panel.3set.online